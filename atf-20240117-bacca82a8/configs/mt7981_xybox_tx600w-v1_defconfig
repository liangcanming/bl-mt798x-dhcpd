# XYBOX TX600W / ZR-3030 v1 — MT7981BA / DDR4 4Gb(512MB) Linkage P3A4GL4BLF-GJN
# 128MiB SPI-NAND，NMBM 由 U-Boot 侧 CONFIG_ENABLE_NAND_NMBM 建 nmbm0
# FIP @0x380000（官方布局，不是默认 0x3c0000）；容量交给 _DRAM_SIZE_AUTO 自检

_PLAT_MT7981=y
_MT7981_BOARD_BGA=y
_DRAM_DDR4=y
_LOG_LEVEL_INFO=y
_ENABLE_OVERRIDE_FIP_BASE=y
OVERRIDE_FIP_BASE=0x380000
_ENABLE_OVERRIDE_FIP_SIZE=y
OVERRIDE_FIP_SIZE=0x200000
