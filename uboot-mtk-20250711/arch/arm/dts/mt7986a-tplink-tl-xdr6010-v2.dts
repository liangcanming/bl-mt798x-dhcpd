// SPDX-License-Identifier: GPL-2.0
// TP-Link TL-XDR6010 v2  (MediaTek MT7986B, SPI-NAND 128MB)
// U-Boot device tree for bl-mt798x-dhcpd
// ubi = 0x600000..0x8000000 (124928k), merged ubi + reserved

/dts-v1/;
#include "mt7986.dtsi"
#include <dt-bindings/gpio/gpio.h>

/ {
	#address-cells = <1>;
	#size-cells = <1>;
	model = "TP-Link TL-XDR6010 v2";
	compatible = "tplink,tl-xdr6010-v2", "mediatek,mt7986";

	chosen {
		stdout-path = &uart0;
		tick-timer = &timer0;
	};

	config {
		bootcmd = "mtkboardboot";
		blink_led = "green:status";
		system_led = "red:status";
	};

	memory@40000000 {
		device_type = "memory";
		reg = <0x40000000 0x20000000>;
	};

	gpio-keys {
		compatible = "gpio-keys";

		button-reset {
			label = "reset";
			linux,code = <KEY_RESTART>;
			gpios = <&pio 9 GPIO_ACTIVE_LOW>;
		};

		button-wps {
			label = "wps";
			linux,code = <BTN_2>;
			gpios = <&pio 10 GPIO_ACTIVE_LOW>;
		};
	};

	gpio-leds {
		compatible = "gpio-leds";

		led_status_red: led-0 {
			label = "red:status";
			gpios = <&pio 7 GPIO_ACTIVE_HIGH>;
		};

		led_status_green: led-1 {
			label = "green:status";
			gpios = <&pio 8 GPIO_ACTIVE_HIGH>;
		};
	};

	bl2_verify {
		bl2_compatible = "spim-nand";
	};

	/* Multi MTD layout (CONFIG_MEDIATEK_MULTI_MTD_LAYOUT) */
	mtd-layout {
		layout@0 {
			label = "default";
			/* stock TP-Link layout: ubi + reserved separate */
			cmdline = "console=ttyS0,115200n8 loglevel=8";
			mtdids = "spi-nand0=spi-nand0";
			mtdparts = "spi-nand0:1024k(bl2),512k(u-boot-env),256k(factory),1792k(tp_data),2560k(fip),65536k(ubi),59392k(reserved)";
			boot_part = "ubi";
			factory_part = "ubi";
			sysupgrade_kernel_ubipart = "ubi";
			sysupgrade_rootfs_ubipart = "ubi";
		};

		layout@1 {
			label = "immortalwrt-122m";
			/* ubi + reserved merged into one 122M ubi */
			mtdids = "spi-nand0=spi-nand0";
			mtdparts = "spi-nand0:1024k(bl2),512k(u-boot-env),256k(factory),1792k(tp_data),2560k(fip),124928k(ubi)";
			boot_part = "ubi";
			factory_part = "ubi";
			sysupgrade_kernel_ubipart = "ubi";
			sysupgrade_rootfs_ubipart = "ubi";
		};
	};
};

&eth {
	status = "okay";
	mediatek,gmac-id = <0>;
	phy-mode = "2500base-x";
	mediatek,switch = "auto";
	reset-gpios = <&pio 5 GPIO_ACTIVE_HIGH>;

	fixed-link {
		speed = <2500>;
		full-duplex;
	};
};

&pio {
	spi_flash_pins: spi0-pins-func-1 {
		mux {
			function = "flash";
			groups = "spi0", "spi0_wp_hold";
		};

		conf-pu {
			pins = "SPI2_CS", "SPI2_HOLD", "SPI2_WP";
			drive-strength = <MTK_DRIVE_4mA>;
			bias-pull-up = <MTK_PUPD_SET_R1R0_00>;
		};

		conf-pd {
			pins = "SPI2_CLK", "SPI2_MOSI", "SPI2_MISO";
			drive-strength = <MTK_DRIVE_4mA>;
			bias-pull-down = <MTK_PUPD_SET_R1R0_00>;
		};
	};
};

&spi0 {
	#address-cells = <1>;
	#size-cells = <0>;
	pinctrl-names = "default";
	pinctrl-0 = <&spi_flash_pins>;
	status = "okay";
	must_tx;
	enhance_timing;
	dma_ext;
	ipm_design;
	support_quad;
	tick_dly = <2>;
	sample_sel = <0>;

	spi_nand@0 {
		compatible = "spi-nand";
		reg = <1>;
		spi-max-frequency = <52000000>;
	};
};

&uart0 {
	status = "okay";
};

&watchdog {
	status = "disabled";
};
